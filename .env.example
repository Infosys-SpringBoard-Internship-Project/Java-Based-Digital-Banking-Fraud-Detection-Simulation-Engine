# FraudShield Environment Variables Template
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
SPRING_DATASOURCE_URL="jdbc:postgresql://your-host:5432/your_database?sslmode=require"
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# =============================================================================
# EMAIL CONFIGURATION (SMTP - Gmail example)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SENDER=your-email@gmail.com
MAIL_SENDER_ADDRESS=your-email@gmail.com
MAIL_SENDER_NAME=FraudShield Alerts
MAIL_PASSWORD=your_app_password
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# =============================================================================
# ML API CONFIGURATION
# =============================================================================
ML_API_URL=http://127.0.0.1:5000/predict
ML_HEALTH_URL=http://127.0.0.1:5000/health

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_DASHBOARD_URL=http://localhost:8080/pages/dashboard.html
